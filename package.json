{
  "name": "english-listening",
  "version": "0.1.0",
  "private": true,
  "description": "Local, single-user English listening trainer: video -> per-sentence transcript -> repeat-listening player.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4317",
    "ingest": "tsx bin/ingest.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
