{
  "name": "english-listening",
  "version": "0.1.0",
  "private": true,
  "description": "Local, single-user English listening trainer: video -> per-sentence transcript -> repeat-listening player.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4317",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4317",
    "ingest": "tsx bin/ingest.ts",
    "tools:install": "node scripts/install-tools.mjs",
    "bench:asr": "tsx scripts/bench-asr.ts",
    "fixture": "node scripts/make-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "espeak-ng": "^1.0.2",
    "msedge-tts": "^2.0.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
