# dependencies
node_modules/
.pnp
.pnp.js

# next.js
.next/
out/
next-env.d.ts
*.tsbuildinfo

# runtime data (never commit: contains local DB + imported media)
data/

# local toolchain binaries (ffmpeg / ffprobe / whisper.cpp / models)
tools/

# test media: the video files are large binaries, the hand-written VTTs are
# tracked on purpose (they are test fixtures)
testmedia/*
!testmedia/*.vtt
!testmedia/*.srt
!testmedia/README.md

# env + logs
.env
.env*.local
*.log
npm-debug.log*
yarn-error.log*

# scratch: browser-test screenshots, saved HTML dumps
_shots/
_tmp_*

# scratch: ad-hoc probe/analysis scripts run from the repo root. These are how
# unknowns get measured (see PROGRESS) and they are deliberately disposable —
# anything worth keeping graduates into scripts/.
/_*.mjs
/_*.ts
/_*.cjs

# editor / os
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
